<Project Sdk="Microsoft.Build.Traversal">
  <PropertyGroup>
    <TraversalGlobalProperties>SolutionDir=$(MSBuildThisFileDirectory);BuildProjectReferences=false;EnableZipContainer=$(EnableZipContainer)</TraversalGlobalProperties>
    <CustomBeforeTraversalProps>$(MSBuildThisFileDirectory)Directory.Build.props</CustomBeforeTraversalProps>
  </PropertyGroup>
  <ItemGroup>
    <!-- x86 -->
    <ProjectReference Include="PanelSwBackendExtension\PanelSwBackendExtension.vcxproj" Properties="Configuration=Release;Platform=Win32" Targets="Restore;Build" BuildInParallel="false"/>
    <ProjectReference Include="DeferredExePackage\DeferredExePackage.vcxproj" Properties="Configuration=Release;Platform=Win32;DebugCA=$(DebugCA)" Targets="Restore;Build" BuildInParallel="false"/>
    <ProjectReference Include="ProtoCaLib\ProtoCaLib.vcxproj" Properties="Configuration=Release;Platform=Win32" Targets="Restore;Build" BuildInParallel="false"/>
    <ProjectReference Include="CaCommon\CaCommon.vcxproj" Properties="Configuration=Release;Platform=Win32" Targets="Restore;Build" BuildInParallel="false"/>
    <ProjectReference Include="Dism\Dism.vcxproj" Properties="Configuration=Release;Platform=Win32" Targets="Restore;Build" BuildInParallel="false"/>
    <ProjectReference Include="PanelSwCustomActions\PanelSwCustomActions.vcxproj" Properties="Configuration=Release;Platform=Win32;DebugCA=$(DebugCA)" Targets="Restore;Build" BuildInParallel="false"/>
    <ProjectReference Include="PswManagedCA\PswManagedCA.csproj" Properties="Configuration=Release;Platform=x86" Targets="Restore;Build" BuildInParallel="false"/>

    <!-- x64 -->
    <ProjectReference Include="PanelSwBackendExtension\PanelSwBackendExtension.vcxproj" Properties="Configuration=Release;Platform=x64" Targets="Restore;Build" BuildInParallel="false"/>
    <ProjectReference Include="DeferredExePackage\DeferredExePackage.vcxproj" Properties="Configuration=Release;Platform=x64;DebugCA=$(DebugCA)" Targets="Restore;Build" BuildInParallel="false"/>
    <ProjectReference Include="ProtoCaLib\ProtoCaLib.vcxproj" Properties="Configuration=Release;Platform=x64" Targets="Restore;Build" BuildInParallel="false"/>
    <ProjectReference Include="CaCommon\CaCommon.vcxproj" Properties="Configuration=Release;Platform=x64" Targets="Restore;Build" BuildInParallel="false"/>
    <ProjectReference Include="Dism\Dism.vcxproj" Properties="Configuration=Release;Platform=x64" Targets="Restore;Build" BuildInParallel="false"/>
    <ProjectReference Include="PanelSwCustomActions\PanelSwCustomActions.vcxproj" Properties="Configuration=Release;Platform=x64;DebugCA=$(DebugCA)" Targets="Restore;Build" BuildInParallel="false"/>
    <ProjectReference Include="PswManagedCA\PswManagedCA.csproj" Properties="Configuration=Release;Platform=x64" Targets="Restore;Build" BuildInParallel="false"/>

    <!-- WiX -->
    <ProjectReference Include="wixlib\PanelSwWixLib.wixproj" Properties="Configuration=Release;Platform=x86" Targets="Restore;Build" BuildInParallel="false" />
    <ProjectReference Include="wixlib\PanelSwWixLib.wixproj" Properties="Configuration=Release;Platform=x64" Targets="Restore;Build" BuildInParallel="false" />
    <ProjectReference Include="PanelSwWixHarvestExtension\PanelSwWixHarvestExtension.csproj" Properties="Configuration=$(Configuration);Platform=AnyCPU" Targets="Restore;Build" BuildInParallel="false" />
    <ProjectReference Include="PanelSwWixExtension\PanelSwWixExtension.csproj" Properties="Configuration=$(Configuration);Platform=AnyCPU;NugetPrereleaseVersion=$(NugetPrereleaseVersion)" Targets="Restore;Build" BuildInParallel="false" />
  </ItemGroup>
  <!-- Build a unit test -->
  <ItemGroup Condition=" '$(UnitTest)' != '' AND '$(UnitTest)' != 'SetPropertyFromPipe' AND '$(UnitTest)' != 'all' ">
    <ProjectReference Include="UnitTests\$(UnitTest)\$(UnitTest).wixproj" Properties="Configuration=$(Configuration);Platform=x86" Targets="Restore;Build" BuildInParallel="false" />
    <ProjectReference Include="UnitTests\$(UnitTest)\$(UnitTest).wixproj" Properties="Configuration=$(Configuration);Platform=x64" Targets="Restore;Build" BuildInParallel="false" Condition=" '$(UnitTestX64)' == '' Or $(UnitTestX64) " />
  </ItemGroup>
  <!-- Build SetPropertyFromPipe unit test -->
  <ItemGroup Condition=" '$(UnitTest)' == 'SetPropertyFromPipe' ">
    <ProjectReference Include="UnitTests\SetPropertyFromPipe\SetPropertyFromPipeBAF\SetPropertyFromPipeBAF.vcxproj" Properties="Configuration=Release;Platform=x86" Targets="Restore;Build" BuildInParallel="false" />
    <ProjectReference Include="UnitTests\SetPropertyFromPipe\SetPropertyFromPipeBAF\SetPropertyFromPipeBAF.vcxproj" Properties="Configuration=Release;Platform=x64" Targets="Restore;Build" Condition=" '$(UnitTestX64)' == '' Or $(UnitTestX64) " BuildInParallel="false" />
    <ProjectReference Include="UnitTests\SetPropertyFromPipe\SetPropertyFromPipeSetup\SetPropertyFromPipeSetup.wixproj" Properties="Configuration=$(Configuration);Platform=x86" Targets="Restore;Build" BuildInParallel="false" />
    <ProjectReference Include="UnitTests\SetPropertyFromPipe\SetPropertyFromPipeSetup\SetPropertyFromPipeSetup.wixproj" Properties="Configuration=$(Configuration);Platform=x64" Targets="Restore;Build" Condition=" '$(UnitTestX64)' == '' Or $(UnitTestX64) " BuildInParallel="false" />
    <ProjectReference Include="UnitTests\SetPropertyFromPipe\SetPropertyFromPipeBootstrapper\SetPropertyFromPipeBootstrapper.wixproj" Properties="Configuration=$(Configuration);Platform=x86" Targets="Restore;Build" BuildInParallel="false" />
    <ProjectReference Include="UnitTests\SetPropertyFromPipe\SetPropertyFromPipeBootstrapper\SetPropertyFromPipeBootstrapper.wixproj" Properties="Configuration=$(Configuration);Platform=x64" Targets="Restore;Build" Condition=" '$(UnitTestX64)' == '' Or $(UnitTestX64) " BuildInParallel="false" />
  </ItemGroup>
  <!-- Build all unit tests -->
  <ItemGroup Condition=" '$(UnitTest)' == 'all' ">
    <ProjectReference Include="UnitTests\*\*.wixproj" Properties="Configuration=$(Configuration);Platform=x86" Targets="Restore;Build" BuildInParallel="true" />
    <ProjectReference Include="UnitTests\*\*.wixproj" Properties="Configuration=$(Configuration);Platform=x64" Targets="Restore;Build" BuildInParallel="true" Condition=" '$(UnitTestX64)' == '' Or $(UnitTestX64) " />
  </ItemGroup>

  <!-- Run unit tests with .bat files -->
  <Target Name="RunTests">
    <ItemGroup>
      <BatchFiles Include="$(BaseBuildFolder)\x86\bin\Release\**\*.bat" Exclude="$(BaseBuildFolder)\x86\bin\Release\RemoveRegistryValueUT\RemoveRegistryValueUT.bat;$(BaseBuildFolder)\x86\bin\Release\CustomUninstallKeyUT\CustomUninstallKeyUT.bat" />
      <BatchFiles Include="$(BaseBuildFolder)\x64\bin\Release\**\*.bat" />
      <PsFiles Include="$(BaseBuildFolder)\x64\bin\Release\**\*.ps1" />
    </ItemGroup>
    <Exec Command="%(BatchFiles.FullPath)" WorkingDirectory="%(BatchFiles.RootDir)%(BatchFiles.Directory)" ConsoleToMsBuild="true" LogStandardErrorAsError="false" StandardErrorImportance="normal" IgnoreStandardErrorWarningFormat="true"/>
    <Exec Command='powershell -File "%(PsFiles.FullPath)"' WorkingDirectory="%(PsFiles.RootDir)%(PsFiles.Directory)" ConsoleToMsBuild="true" LogStandardErrorAsError="false" StandardErrorImportance="normal" IgnoreStandardErrorWarningFormat="true"/>
  </Target>
  
  <ItemGroup>
    <PackageReference Include="TidyBuild" />
  </ItemGroup>
  
  <ItemGroup>
    <AllMyProjects Include="@(ProjectReference->Distinct())" />
    <AllMyProjects Include="UnitTests\**\*.*proj" />
  </ItemGroup>
  
  <!-- Convert projects to PanelSwWix4 -->
  <Target Name="WixtoolsetToPanelSwWix4" Inputs="%(AllMyProjects.FullPath)" Outputs="%(AllMyProjects.FullPath).never">
    <PropertyGroup>
      <JsonFileContents>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)global.json'))</JsonFileContents>
      <JsonFileContents>$([System.Text.RegularExpressions.Regex]::Replace('$(JsonFileContents)', '"PanelSwWix4.Sdk".*', '"PanelSwWix4.Sdk": "$(PanelSwWix4Version)",'))</JsonFileContents>
    </PropertyGroup>

    <WriteLinesToFile File="$(MSBuildThisFileDirectory)global.json"
                      Lines="$(JsonFileContents)"
                      Overwrite="true"/>

    <PropertyGroup>
      <ProjectFileContents>$([System.IO.File]::ReadAllText('%(AllMyProjects.FullPath)'))</ProjectFileContents>
      <ProjectFileContents>$(ProjectFileContents.Replace('WixToolset.', 'PanelSwWix4.'))</ProjectFileContents>
    </PropertyGroup>

    <WriteLinesToFile File="%(AllMyProjects.FullPath)"
                      Lines="$(ProjectFileContents)"
                      Overwrite="true" 
                      WriteOnlyWhenDifferent="true" />
  </Target>
</Project>

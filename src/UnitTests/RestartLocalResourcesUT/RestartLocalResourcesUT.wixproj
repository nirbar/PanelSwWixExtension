<Project Sdk="WixToolset.Sdk">
  <PropertyGroup>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <CoreCompileDependsOn>DownloadNssm;$(CoreCompileDependsOn)</CoreCompileDependsOn>
  </PropertyGroup>
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <ProductVersion>3.8</ProductVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="RestartLocalResourcesUT.wxs" />
  </ItemGroup>
  <ItemGroup>
    <WixExtension Include="PanelSwWixExtension">
      <HintPath>$(BuildFolder)..\AnyCPU\bin\$(Configuration)\PanelSwWixExtension\PanelSwWixExtension.dll</HintPath>
      <Name>PanelSwWixExtension</Name>
    </WixExtension>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="TidyBuild" />
    <PackageReference Include="WixToolset.UI.wixext" />
  </ItemGroup>
  <PropertyGroup>
     <DefineConstants>BuildFolderCommon=$(BuildFolderCommon);$(DefineConstants)</DefineConstants>
  </PropertyGroup>
  <Target Name="DownloadNssm" Condition="!Exists('$(BuildFolderCommon)\nssm.exe')">
    <DownloadFile SourceUrl="https://github.com/nirbar/nssm/releases/download/4/nssm.exe" DestinationFolder="$(BuildFolderCommon)"/>
  </Target>
</Project>

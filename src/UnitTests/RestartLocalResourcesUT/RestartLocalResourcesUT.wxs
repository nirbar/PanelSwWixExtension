<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:PanelSW="http://schemas.panel-sw.co.il/wix/WixExtension" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://schemas.panel-sw.co.il/wix/WixExtension ../../PanelSwWixExtension/XSD/PanelSwWixExtension.xsd">
  <Package Name="RestartLocalResourcesUT" Language="1033" Version="$(var.JetVersion)" Manufacturer="$(var.JetManufacturer)" UpgradeCode="d377fd04-a940-4ed2-8d55-e2f1f6f39d2d" InstallerVersion="200">
    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />

    <Property Id="MSIFASTINSTALL" Value="1"></Property>
    <Property Id="MSIRMSHUTDOWN" Value="1" />
    <Property Id="MSIDISABLERMRESTART" Value="1" />
    <UIRef Id="WixUI_Minimal_$(sys.BUILDARCHSHORT)"/>

    <Feature Id="ProductFeature" Title="RestartLocalResourcesUT" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
    </Feature>

    <ComponentGroup Id="ProductComponents">
      <Component Directory="INSTALLFOLDER2">
        <File Id="nssm.exe2" Source="$(BuildFolderCommon)\nssm-2.24\win64\nssm.exe"/>

        <ServiceInstall Name="RestartLocalResourcesUT2" Type="ownProcess" Start="auto" ErrorControl="normal" Interactive="yes">
          <ServiceDependency Id="RestartLocalResourcesUT"/>
        </ServiceInstall>
        <ServiceControl Name="RestartLocalResourcesUT2" Remove="uninstall" Start="install"/>
        <PanelSW:NssmServiceConfig ServiceName="RestartLocalResourcesUT2" Application="ping.exe" AppDirectory="[INSTALLFOLDER]" AppParameters="google.com /n 1000" AppExit='Restart' />
      </Component>
      <Component Directory="INSTALLFOLDER">
        <File Id="nssm.exe" Source="$(BuildFolderCommon)\nssm-2.24\win64\nssm.exe"/>

        <ServiceInstall Name="RestartLocalResourcesUT" Type="ownProcess" Start="auto" ErrorControl="normal" Interactive="yes"/>
        <ServiceControl Name="RestartLocalResourcesUT" Remove="uninstall" Start="install"/>
        <PanelSW:NssmServiceConfig ServiceName="RestartLocalResourcesUT" Application="ping.exe" AppDirectory="[INSTALLFOLDER]" AppParameters="google.com /n 1000" AppExit='Restart' />
      </Component>
    </ComponentGroup>

    <Property Id="NPP_FOLDER" Value="C:\Users\Administrator\Desktop\Notepad++\"/>
    <PanelSW:RestartLocalResources Path="[NPP_FOLDER]" />
    <PanelSW:RestartLocalResources Path="[INSTALLFOLDER]" />

    <InstallExecuteSequence>
      <Custom Action="override RestartLocalResourcesExec" Before="DeleteServices"/>
    </InstallExecuteSequence>

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="RestartLocalResourcesUT" />
      <Directory Id="INSTALLFOLDER2" Name="RestartLocalResourcesUT2" />
    </StandardDirectory>
  </Package>
</Wix>

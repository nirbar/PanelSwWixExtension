<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:PanelSW="http://schemas.panel-sw.co.il/wix/WixExtension">
  <Package Name="CustomUninstallKeyUT" Language="1033" Version="$(var.JetVersion)" Manufacturer="Nir Bar" UpgradeCode="370186f7-0cd5-4fb1-82c1-382311d94780" InstallerVersion="200" ProductCode="{9972FF2F-0828-4B45-81A0-9E71B07DFC83}">

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <Property Id="MSIFASTINSTALL" Value="1"/>

    <Feature Id="ProductFeature" Title="UnitTestSetup" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
    </Feature>
    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="UnitTestSetup" />
    </StandardDirectory>

    <!-- Test designed for x64 package! -->
    <PanelSW:CustomUninstallKey Name="newVal" Data="1" DataType="REG_DWORD" />
    <PanelSW:CustomUninstallKey Name="newVal" ProductCode="CustomUninstallKeyUT" Data="1" DataType="REG_DWORD" Condition="" />
    <PanelSW:CustomUninstallKey Name="existingVal" ProductCode="CustomUninstallKeyUT" Data="1" DataType="REG_DWORD" />

    <ComponentGroup Id="ProductComponents">
      <Component Id="Test" Directory="INSTALLFOLDER">
        <File Id="Test" Source="$(sys.SOURCEFILEDIR)CustomUninstallKeyUT.bat" Compressed="no"/>
      </Component>
    </ComponentGroup>

    <InstallExecuteSequence>
      <Custom Action="Rollback_Deferred" Before="InstallFinalize" Condition="DO_ROLLBACK"/>
    </InstallExecuteSequence>
  </Package>
</Wix>

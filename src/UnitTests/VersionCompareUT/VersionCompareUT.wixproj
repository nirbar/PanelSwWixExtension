<Project Sdk="WixToolset.Sdk">
  <PropertyGroup>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <CoreCompileDependsOn>DownloadNssm;$(CoreCompileDependsOn)</CoreCompileDependsOn>
  </PropertyGroup>
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <ProductVersion>3.8</ProductVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="VersionCompareUT.wxs" />
  </ItemGroup>
  <ItemGroup>
    <WixExtension Include="PanelSwWixExtension">
      <HintPath>$(BuildFolder)..\AnyCPU\bin\$(Configuration)\PanelSwWixExtension\PanelSwWixExtension.dll</HintPath>
      <Name>PanelSwWixExtension</Name>
    </WixExtension>
    <PackageReference Include="TidyBuild" />
  </ItemGroup>
  <PropertyGroup>
    <DefineConstants>BuildFolderCommon=$(BuildFolderCommon);$(DefineConstants)</DefineConstants>
  </PropertyGroup>
  <Target Name="DownloadNssm" Condition="!Exists('$(BuildFolderCommon)\nssm-2.24\win64\nssm.exe')">
    <DownloadFile SourceUrl="https://nssm.cc/release/nssm-2.24.zip" DestinationFolder="$(BuildFolderCommon)"/>
    <Unzip SourceFiles="$(BuildFolderCommon)\nssm-2.24.zip" DestinationFolder="$(BuildFolderCommon)"/>
  </Target>
</Project>

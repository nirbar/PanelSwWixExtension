<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal" xmlns:PanelSW="http://schemas.panel-sw.co.il/wix/WixExtension"
     xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://schemas.panel-sw.co.il/wix/WixExtension ../../PanelSwWixExtension/XSD/PanelSwWixExtension.xsd">
  
  <?define UpgradeCode=f37b5c48-dd17-4ff6-af58-1bd697c2c1d7?>
  <Bundle Name="BundleSearchUT" Version="$(var.JetVersion)" Manufacturer="$(var.JetManufacturer)" UpgradeCode="$(UpgradeCode)" bal:CommandLineVariables="caseInsensitive">
    <BootstrapperApplication>
      <bal:WixStandardBootstrapperApplication Theme="rtfLicense" LicenseUrl="www.google.com"/>
    </BootstrapperApplication>

    <Variable Name="SKIP_CONDITIONS" Value="0" Type="numeric" bal:Overridable="yes"/>

    <!-- BundleVariableSearch tests -->
    <Variable Name="wix" Value="Wix" Persisted="yes" Type="string"/>
    <Variable Name="bundle" Value="Bundle" Persisted="yes" Type="string"/>
    <Variable Name="name" Value="Name" Persisted="yes" Type="string"/>
    <Variable Name="myWiXBundleName" Value="[[wix][bundle][name]]" Persisted="yes" Type="string"/>
    <PanelSW:BundleVariableSearch Condition='SKIP_CONDITIONS&lt;&gt;1' ResultVariable="testWiXBundleName" SearchVariable="myWiXBundleName" UpgradeCode="$(UpgradeCode)"/>
    <bal:Condition Condition='(SKIP_CONDITIONS=1) OR NOT WixBundleInstalled OR (testWiXBundleName="BundleSearchUT")' Message="Expected testWiXBundleName to be BundleSearchUT"/>
    <PanelSW:BundleVariableSearch Condition='SKIP_CONDITIONS&lt;&gt;1' ResultVariable="testWiXBundleNameUnformatted" SearchVariable="myWiXBundleName" Format="no" UpgradeCode="$(UpgradeCode)"/>
    <bal:Condition Condition='(SKIP_CONDITIONS=1) OR NOT WixBundleInstalled OR (testWiXBundleNameUnformatted="[[wix][bundle][name]]")' Message="Expected testWiXBundleNameUnformatted to be '[[wix][bundle][name]]'"/>

    <Variable Name="SomeVersion" Value="$(var.JetVersion)" Persisted="yes" Type="version"/>
    <PanelSW:BundleVariableSearch Condition='SKIP_CONDITIONS&lt;&gt;1' After="testFolder" ResultVariable="testVersion" SearchVariable="SomeVersion" UpgradeCode="$(UpgradeCode)"/>
    <bal:Condition Condition="(SKIP_CONDITIONS=1) OR NOT WixBundleInstalled OR (testVersion=v$(JetVersion))" Message="Expected testVersion to be $(JetVersion)"/>

    <Variable Name="InstallFolder" Value="[ProgramFiles6432Folder]test" Persisted="yes" Type="formatted"/>
    <PanelSW:BundleVariableSearch Condition='SKIP_CONDITIONS&lt;&gt;1' Id="testFolder" ResultVariable="testFolder" SearchVariable="InstallFolder" UpgradeCode="$(UpgradeCode)"/>
    <PanelSW:BundleVariableSearch Condition='SKIP_CONDITIONS&lt;&gt;1' ResultVariable="testPlatform" SearchVariable="WixBundlePlatform" UpgradeCode="$(UpgradeCode)"/>
    <bal:Condition Condition='(SKIP_CONDITIONS=1) OR NOT WixBundleInstalled OR (testPlatform="x86") OR (testPlatform="x64")' Message='Expected testFolder to be "C:\Program Files (x86)\test"'/>
    <bal:Condition Condition='(SKIP_CONDITIONS=1) OR NOT WixBundleInstalled OR ((testPlatform="x64") AND (testFolder="C:\Program Files\test")) OR ((testPlatform="x86") AND (testFolder="C:\Program Files (x86)\test"))' Message='Expected testFolder to be "C:\Program Files (x86)\test" or "C:\Program Files\test"'/>

    <Variable Name="SomeNumber" Value="3" Persisted="yes" Type="numeric"/>
    <PanelSW:BundleVariableSearch Condition='SKIP_CONDITIONS&lt;&gt;1' ResultVariable="testNumber" After="never" SearchVariable="SomeNumber" UpgradeCode="$(UpgradeCode)"/>
    <bal:Condition Condition='(SKIP_CONDITIONS=1) OR NOT WixBundleInstalled OR (testNumber=3)' Message='Expected testNumber to be 3'/>

    <PanelSW:BundleVariableSearch Id="never" ResultVariable="testNever" Condition="1=0" SearchVariable="SomeNumber" UpgradeCode="$(UpgradeCode)"/>
    <bal:Condition Condition='(SKIP_CONDITIONS=1) OR NOT testNever' Message='Expected testNever to be empty'/>

    <Variable Name="myMalFormatted" Value="[[wix][bundle]]version[]" Persisted="yes" Type="string"/>
    <PanelSW:BundleVariableSearch Condition='SKIP_CONDITIONS&lt;&gt;1' ResultVariable="testMalFormatted" SearchVariable="myMalFormatted" UpgradeCode="$(UpgradeCode)"/>
    <bal:Condition Condition='(SKIP_CONDITIONS=1) OR NOT WixBundleInstalled OR (testMalFormatted="version")' Message="Expected testWiXBundleVersion to be 'version'"/>

    <Variable Name="TooDeep" Value="[TooDeep]" Persisted="yes" Type="string"/>
    <PanelSW:BundleVariableSearch Condition='SKIP_CONDITIONS&lt;&gt;1' ResultVariable="testTooDeep" SearchVariable="TooDeep" UpgradeCode="$(UpgradeCode)"/>
    <bal:Condition Condition='(SKIP_CONDITIONS=1) OR NOT WixBundleInstalled OR NOT testTooDeep' Message="Expected testTooDeep to be empty"/>

    <PanelSW:BundleVariableSearch Condition='SKIP_CONDITIONS&lt;&gt;1' ResultVariable="testWixBundlePlatform" SearchVariable="WixBundlePlatform" UpgradeCode="$(UpgradeCode)"/>
    <bal:Condition Condition='(SKIP_CONDITIONS=1) OR NOT WixBundleInstalled OR (testWixBundlePlatform="x86") OR (testWixBundlePlatform="x64")' Message="Expected testWixBundlePlatform to be x86 or x64"/>

    <PanelSW:BundleVariableSearch Condition='SKIP_CONDITIONS&lt;&gt;1' ResultVariable="testWixBundleContext" SearchVariable="WixBundleContext" UpgradeCode="$(UpgradeCode)"/>
    <bal:Condition Condition='(SKIP_CONDITIONS=1) OR NOT WixBundleInstalled OR (testWixBundleContext="machine")' Message="Expected testWixBundleContext to be machine"/>

    <PanelSW:BundleVariableSearch Condition='SKIP_CONDITIONS&lt;&gt;1' ResultVariable="testDoesntExist" SearchVariable="DoesntExist" UpgradeCode="$(UpgradeCode)"/>
    <bal:Condition Condition='(SKIP_CONDITIONS=1) OR NOT WixBundleInstalled OR NOT testDoesntExist' Message="Expected testDoesntExist to be empty"/>

    <Variable Name="NotPersisted" Value="1" Type="numeric"/>
    <PanelSW:BundleVariableSearch Condition='SKIP_CONDITIONS&lt;&gt;1' ResultVariable="testNotPersisted" SearchVariable="NotPersisted" UpgradeCode="$(UpgradeCode)"/>
    <bal:Condition Condition='(SKIP_CONDITIONS=1) OR NOT testNotPersisted' Message="Expected testNotPersisted to be empty"/>

    <Variable Name="NotChanged" Value="1" Type="numeric"/>
    <PanelSW:BundleVariableSearch Condition='SKIP_CONDITIONS&lt;&gt;1' ResultVariable="NotChanged" SearchVariable="NotChanged" UpgradeCode="$(UpgradeCode)"/>
    <bal:Condition Condition='(SKIP_CONDITIONS=1) OR (NotChanged=1)' Message="Expected NotChanged to be 1"/>

    <PanelSW:BundleVariableSearch Condition='SKIP_CONDITIONS&lt;&gt;1' ResultVariable="testWixBundleInstalled" SearchVariable="WixBundleInstalled" UpgradeCode="$(UpgradeCode)"/>
    <bal:Condition Condition='(SKIP_CONDITIONS=1) OR (testWixBundleInstalled = WixBundleInstalled)' Message="Expected testWixBundleInstalled to equal WixBundleInstalled"/>

    <Variable Name="OVRD_ON_COMMAND_LINE" Value="" Type="string" bal:Overridable="yes" Persisted="yes"/>
    <PanelSW:BundleVariableSearch Condition='SKIP_CONDITIONS&lt;&gt;1' ResultVariable="OVRD_ON_COMMAND_LINE" SearchVariable="OVRD_ON_COMMAND_LINE" UpgradeCode="$(UpgradeCode)"/>
    <bal:Condition Condition='(SKIP_CONDITIONS=1) OR NOT WixBundleInstalled OR (OVRD_ON_COMMAND_LINE = 1)' Message="Expected OVRD_ON_COMMAND_LINE to be 1"/>

    <Variable Name="CANT_OVRD_ON_COMMAND_LINE" Value="1" Type="string" Persisted="yes"/>
    <PanelSW:BundleVariableSearch Condition='SKIP_CONDITIONS&lt;&gt;1' ResultVariable="CANT_OVRD_ON_COMMAND_LINE" SearchVariable="CANT_OVRD_ON_COMMAND_LINE" UpgradeCode="$(UpgradeCode)"/>
    <bal:Condition Condition='(SKIP_CONDITIONS=1) OR (CANT_OVRD_ON_COMMAND_LINE = 1)' Message="Expected CANT_OVRD_ON_COMMAND_LINE to be 1"/>

    <!-- ArpEntrySearch tests -->
    <PanelSW:ArpEntrySearch ArpKey="BundleSearchUT-BadVersion" Variable="ArpEntrySearch_BadVersion" Bitness="always32" Condition="SKIP_CONDITIONS&lt;&gt;1"/>
    <bal:Condition Condition='(SKIP_CONDITIONS=1) OR ArpEntrySearch_BadVersion=&quot;abcd&quot;' Message="Expected ArpEntrySearch_BadVersion to be 'abcd'"/>

    <PanelSW:ArpEntrySearch ArpKey="BundleSearchUT-Version9999" Variable="ArpEntrySearch_NoMatch" Bitness="always32" Condition="SKIP_CONDITIONS&lt;&gt;1"/>
    <bal:Condition Condition='(SKIP_CONDITIONS=1) OR NOT ArpEntrySearch_NoMatch' Message="Expected ArpEntrySearch_NoMatch to be empty"/>

    <PanelSW:ArpEntrySearch ArpKey="BundleSearchUT-Version*" Variable="ArpEntrySearch_Version1234" Bitness="always32" Condition="SKIP_CONDITIONS&lt;&gt;1"/>
    <bal:Condition Condition='(SKIP_CONDITIONS=1) OR ArpEntrySearch_Version1234=v1.2.3.4' Message="Expected ArpEntrySearch_Version1234 to be v1.2.3.4"/>

    <PanelSW:ArpEntrySearch ArpKey="BundleSearchUT-Version????" Variable="ArpEntrySearch_Version2345" Bitness="always64" Scope="perMachine" Condition="SKIP_CONDITIONS&lt;&gt;1"/>
    <bal:Condition Condition='(SKIP_CONDITIONS=1) OR ArpEntrySearch_Version2345=v2.3.4.5' Message="Expected ArpEntrySearch_Version2345 to be v2.3.4.5"/>

    <PanelSW:ArpEntrySearch ArpKey="BundleSearchUT-Version????" Variable="ArpEntrySearch_Version3456" Bitness="always64" Scope="perUser" Condition="SKIP_CONDITIONS&lt;&gt;1"/>
    <bal:Condition Condition='(SKIP_CONDITIONS=1) OR ArpEntrySearch_Version3456=v3.4.5.6' Message="Expected ArpEntrySearch_Version3456 to be v3.4.5.6"/>

    <Chain ParallelCache="yes" DisableSystemRestore="yes">
      <ExePackage SourceFile="$(DeferredExePackagePath)" DetectCondition="1=0" UninstallArguments="/u" InstallArguments="--ignore-me">
        <Payload SourceFile="$(sys.SOURCEFILEDIR)BundleSearchUT.bat" Compressed="no"/>
      </ExePackage>
    </Chain>
  </Bundle>
</Wix>
